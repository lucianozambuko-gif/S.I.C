# ---- Required in production ----
NODE_ENV=production
# Long random string: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# First admin login (created on first start; change the password in Settings afterwards)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# ---- Database (Turso). Leave empty locally to use data/sic.db ----
TURSO_DATABASE_URL=libsql://sic-growth-yourname.turso.io
TURSO_AUTH_TOKEN=

# Public address of the site, used in email links
PUBLIC_URL=https://sic-growth.onrender.com

# ---- Email alerts and auto-replies (optional but recommended) ----
# Works with Gmail (smtp.gmail.com, 465, app password), Brevo, Resend SMTP, Zoho, etc.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="S.I.C <hello@sicagency.com>"
# Where new-enquiry alerts go if not set in the dashboard
NOTIFY_EMAIL=

# ---- Video and photo uploads (optional) ----
# From the Cloudinary dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=sic-growth
